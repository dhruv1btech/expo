import React, { useState } from 'react';
import { View, Text, TextInput, Picker, Button, ScrollView, StyleSheet } from 'react-native';

export default function App() {
  const [userName, setUserName] = useState('');
  const [wasteType, setWasteType] = useState('Wet');
  const [amount, setAmount] = useState('');
  const [community, setCommunity] = useState({
    Wet: 0,
    Dry: 0,
    Recyclable: 0,
    Hazardous: 0,
  });
  const [message, setMessage] = useState('');

  const submitWaste = () => {
    if (!userName || !amount) {
      alert('Please fill all fields');
      return;
    }
    const amt = parseInt(amount);
    if (isNaN(amt) || amt <= 0) {
      alert('Enter a valid amount');
      return;
    }
    setCommunity(prev => ({
      ...prev,
      [wasteType]: prev[wasteType] + amt,
    }));
    setMessage(`Thanks ${userName}! You have added ${amt} kg of ${wasteType} waste.`);
    setAmount('');
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.header}>Smart Waste Management</Text>

      <Text style={styles.label}>Your Name:</Text>
      <TextInput
        style={styles.input}
        value={userName}
        onChangeText={setUserName}
        placeholder="Enter your name"
      />

      <Text style={styles.label}>Select Waste Type:</Text>
      <Picker
        selectedValue={wasteType}
        onValueChange={setWasteType}
        style={styles.picker}
      >
        <Picker.Item label="Wet Waste" value="Wet" />
        <Picker.Item label="Dry Waste" value="Dry" />
        <Picker.Item label="Recyclable Waste" value="Recyclable" />
        <Picker.Item label="Hazardous Waste" value="Hazardous" />
      </Picker>

      <Text style={styles.label}>Amount (kg):</Text>
      <TextInput
        style={styles.input}
        value={amount}
        onChangeText={setAmount}
        keyboardType="numeric"
        placeholder="Enter amount"
      />

      <Button title="Add Waste" onPress={submitWaste} />

      {message ? <Text style={styles.message}>{message}</Text> : null}

      <View style={styles.stats}>
        <Text style={styles.statsHeader}>Community Waste Statistics:</Text>
        <Text>Wet Waste: {community.Wet} kg</Text>
        <Text>Dry Waste: {community.Dry} kg</Text>
        <Text>Recyclable Waste: {community.Recyclable} kg</Text>
        <Text>Hazardous Waste: {community.Hazardous} kg</Text>
      </View>

      <View style={styles.centers}>
        <Text style={styles.statsHeader}>Nearest Recycling Centers (Example):</Text>
        <Text>- Green Earth Recycling - Main Street</Text>
        <Text>- EcoSort Facility - Park Avenue</Text>
        <Text style={{fontStyle: 'italic'}}>
          (Integrate map APIs to show real locations in a complete app)
        </Text>
      </View>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { padding: 20 },
  header: { fontSize: 26, fontWeight: 'bold', marginBottom: 20, textAlign: 'center' },
  label: { fontSize: 16, marginTop: 10 },
  input: { borderColor: '#ccc', borderWidth: 1, padding: 8, marginTop: 5, borderRadius: 5 },
  picker: { height: 50, marginTop: 5 },
  message: { marginTop: 15, fontSize: 16, color: 'green' },
  stats: { marginTop: 25, padding: 15, backgroundColor: '#e6f2ff', borderRadius: 8 },
  statsHeader: { fontWeight: 'bold', marginBottom: 10, fontSize: 18 },
  centers: { marginTop: 25, padding: 15, backgroundColor: '#fff3e6', borderRadius: 8 },
});
